APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# For production use MySQL. For local development SQLite is fine.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=laravel
# DB_PASSWORD=change-me

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Reverb (real-time broadcasting) ---
# Generate these with: php artisan reverb:install
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
REVERB_APP_MAX_MESSAGE_SIZE=10000
REVERB_APP_RATE_LIMITING_ENABLED=true
REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=60
REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_REVERB_WSS_PORT=443
VITE_REVERB_AUTH_ENDPOINT="/reverb/auth"

# --- Gemini AI ---
# Obtain a key at: https://aistudio.google.com/apikey
# NEVER commit the real key to source control.
GEMINI_API_KEY=
GEMINI_MODEL="gemini-flash-latest"
GEMINI_API_URL="https://generativelanguage.googleapis.com/v1beta/models/"
GEMINI_CONNECT_TIMEOUT=5
GEMINI_REQUEST_TIMEOUT=25
GEMINI_MAX_OUTPUT_TOKENS=600
GEMINI_TEMPERATURE=0.5
GEMINI_MAX_RETRIES=0

# --- Groq AI (fallback provider) ---
# Obtain a key at: https://console.groq.com/keys
# NEVER commit the real key to source control.
GROQ_API_KEY=
GROQ_MODEL="llama-3.1-8b-instant"
GROQ_API_URL="https://api.groq.com/openai/v1/chat/completions"
GROQ_CONNECT_TIMEOUT=5
GROQ_REQUEST_TIMEOUT=25
GROQ_MAX_OUTPUT_TOKENS=600
GROQ_TEMPERATURE=0.5
GROQ_MAX_RETRIES=0

# --- Chat rate limiting ---
CHAT_RATE_LIMIT_PER_MINUTE=30